{
  "id": "ctx-memory-store",
  "name": "记忆存储与调度",
  "version": "1.0.0",
  "description": "持久记忆文件读写、<MEMORY> 捕获写盘、每小时重写调度、每日 22:00 先强制刷新记忆再发日记（含补发）、日记按天归档到 state/memory/diary/<日期>.md（控制台可查历史）；桥接只提供唤醒/发送能力。",
  "layer": "C",
  "category": "上下文与记忆",
  "order": 21,
  "tags": [
    "记忆",
    "日记",
    "调度"
  ],
  "main": "index.js",
  "enabled": true,
  "hooks": [
    "onIncoming",
    "onTick"
  ],
  "schedule": {
    "everyMs": 60000
  },
  "config": {
    "diaryArchive": {
      "maxChars": 20000
    }
  },
  "wakeReasons": [
    "memoryWrite"
  ]
}
