{
  "id": "obs-cost-policy",
  "name": "成本策略（调用档位）",
  "version": "0.2.1",
  "description": "小鲸鱼所有会话、主动处理和独立任务的统一模型与思考档位；内部维护使用本组件默认档位，复杂或明确指定任务使用配置的升级档位。保存时同步已有会话和未完成任务。",
  "category": "可观测性与运维",
  "layer": "O",
  "order": 62,
  "tags": [
    "成本",
    "档位",
    "路由"
  ],
  "main": "index.js",
  "enabled": true,
  "hooks": [
    "onIncoming"
  ],
  "config": {
    "defaultModel": "deepseek-flash",
    "defaultEffort": "low",
    "upgradeModel": "deepseek-v4-pro",
    "upgradeEffort": "high",
    "autoUpgradeComplexTasks": true
  },
  "configSchema": {
    "autoUpgradeComplexTasks": { "type": "boolean" },
    "defaultModel": {
      "enum": [
        "deepseek-flash",
        "deepseek-v4-pro"
      ]
    },
    "upgradeModel": {
      "enum": [
        "deepseek-flash",
        "deepseek-v4-pro"
      ]
    },
    "defaultEffort": {
      "enum": [
        "low",
        "medium",
        "high",
        "max"
      ]
    },
    "upgradeEffort": {
      "enum": [
        "low",
        "medium",
        "high",
        "max"
      ]
    }
  }
}
