{
  "id": "ctx-interest-terms",
  "name": "词条",
  "version": "1.1.0",
  "description": "按适用来源默认注入确认词条；支持多群/多私聊，完整名称可按需查询。",
  "layer": "C",
  "category": "上下文与记忆",
  "order": 19,
  "tags": [
    "学习",
    "词条",
    "共同兴趣",
    "游戏玩法",
    "文化"
  ],
  "main": "index.js",
  "enabled": true,
  "hooks": [
    "onIncoming",
    "onTick",
    "beforePrompt"
  ],
  "schedule": {
    "everyMs": 60000
  },
  "config": {
    "autoExtract": true,
    "autoResearch": true,
    "minMessages": 12,
    "cooldownMs": 1800000,
    "maxCallsPerHour": 4,
    "injectMax": 3
  },
  "configSchema": {
    "minMessages": {
      "min": 2,
      "max": 60
    },
    "cooldownMs": {
      "min": 60000,
      "max": 86400000
    },
    "maxCallsPerHour": {
      "min": 1,
      "max": 12
    },
    "injectMax": {
      "min": 0,
      "max": 40,
      "example": "设为3：每轮最多默认注入当前适用名单内的3条已确认资料；0只保留查询。"
    }
  },
  "prompt": {
    "maxChars": 64000
  }
}
