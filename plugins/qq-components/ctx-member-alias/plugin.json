{
  "id": "ctx-member-alias",
  "name": "绰号",
  "version": "1.2.0",
  "description": "按适用来源注入确认绰号；回复具体QQ或匹配绰号时按需查询，候选仍需审核。",
  "category": "上下文与记忆",
  "layer": "C",
  "order": 18,
  "tags": [
    "绰号",
    "昵称",
    "QQ号",
    "传话",
    "成员"
  ],
  "main": "index.js",
  "enabled": true,
  "hooks": [
    "onIncoming",
    "beforePrompt",
    "onTick"
  ],
  "config": {
    "autoExtract": true,
    "autoSemantic": true,
    "minMessages": 15,
    "cooldownMs": 1800000,
    "maxCallsPerHour": 4,
    "injectMax": 40
  },
  "schedule": {
    "everyMs": 60000
  },
  "configSchema": {
    "injectMax": {
      "min": 0,
      "max": 40,
      "example": "设为3：每轮最多默认注入当前适用名单内的3条已确认资料；0只保留查询。"
    }
  }
}
