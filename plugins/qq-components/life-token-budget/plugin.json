{
  "id": "life-token-budget",
  "name": "会话花费分级",
  "version": "0.4.2",
  "description": "会话花费分级：冷漠私聊按可配置来信条数、群聊按间隔处理；普通聊天达到硬上限后静默，通知依原任务权限直投。",
  "layer": "O",
  "category": "令牌与花费",
  "order": 21,
  "main": "index.js",
  "enabled": true,
  "hooks": [
    "onTick"
  ],
  "schedule": {
    "everyMs": 60000
  },
  "config": {
    "dailyResetTime": "22:00",
    "sessions": {},
    "ownerBudgetEnabled": true,
    "globalHardLimitYuan": 0,
    "recoveryWindows": {
      "privateMessages": 5,
      "groupMessages": 5,
      "groupAtMessages": 5
    },
    "mechanicalPrivateReplies": [],
    "mechanicalGroupReplies": [],
    "mechanicalLimits": {
      "minIntervalMs": 10000,
      "maxPerMinute": 4,
      "maxPerHour": 30
    },
    "privateWakeEveryMessages": 5
  },
  "configSchema": {
    "dailyResetTime": {
      "type": "string",
      "editable": false,
      "label": "每日额度重置时间（北京时间）",
      "description": "00:00–23:59，默认22:00；所有会话与后台任务共用，由令牌与花费页面保存。修改后按新边界重算，不删除历史流水。"
    },
    "mechanicalLimits": {
      "type": "object",
      "editable": false,
      "description": "兼容保留的历史固定回复限流配置；普通聊天达到硬上限后不发送固定回复。"
    },
    "privateWakeEveryMessages": {
      "type": "number",
      "editable": false,
      "description": "全局私聊冷漠触发条数，按会话分别累计，默认5，范围1–100；由令牌与花费页面管理。"
    }
  }
}
