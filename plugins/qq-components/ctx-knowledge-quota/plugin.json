{
  "id": "ctx-knowledge-quota",
  "name": "专业问答配额",
  "version": "0.2.0",
  "description": "C 层专业问答配额：领域关键词与明确请求规则识别，按日和会话/群成员计数；模型派发前通过预检机械带过超额请求，同一消息重试不重复扣额或发送。",
  "category": "上下文与记忆",
  "order": 26,
  "tags": [
    "配额",
    "上下文",
    "专业问答"
  ],
  "main": "index.js",
  "enabled": true,
  "hooks": [
    "beforePrompt"
  ],
  "config": {
    "enabled": true,
    "dailyLimit": 3,
    "resetHour": 0,
    "exemptOwner": true,
    "countBy": "session",
    "deflectText": "唔，这个专业问题我现在有点说不清，你先自己查查资料，好不好？",
    "keywords": [
      "算法", "复杂度", "代码", "报错", "调试", "bug", "Bug", "BUG", "数学", "证明", "推导", "定理", "公式",
      "论文", "编译", "接口", "协议", "架构", "性能", "优化", "模型", "梯度", "数据库", "并发", "内存",
      "正则", "递归", "排序", "线程", "进程", "git", "Git", "docker", "Docker", "SQL", "sql", "python", "Python",
      "科研", "实验", "文献", "微积分", "积分", "导数", "矩阵", "概率", "统计", "物理", "化学", "生物",
      "方程", "量子", "电磁", "力学", "强化学习", "机器学习", "神经网络", "algorithm"
    ]
  },
  "layer": "C",
  "configSchema": {
    "dailyLimit": { "min": 0, "max": 1000 },
    "resetHour": { "min": 0, "max": 23 },
    "countBy": { "enum": ["session", "user"] },
    "deflectText": { "label": "超额时实际发送的短句", "description": "直接发送这句文字，不调用模型生成；空白会回落默认，换行合并，最多120字符。" }
  }
}
