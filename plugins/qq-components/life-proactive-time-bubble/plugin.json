{
  "id": "life-proactive-time-bubble",
  "name": "时间冒泡",
  "version": "0.1.0",
  "description": "到点主动冒个泡（午饭点/起床/该睡了），文案要求由本插件产出；不是回复谁，也不接旧话题。",
  "category": "生命周期与编排",
  "order": 40,
  "tags": [
    "时间",
    "主动开口"
  ],
  "main": "index.js",
  "enabled": true,
  "hooks": [
    "beforePrompt"
  ],
  "config": {
    "maxBubblesPerDay": 4
  },
  "layer": "L",
  "wakeReasons": [
    "timeBubble"
  ]
}
