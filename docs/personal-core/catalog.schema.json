{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Core catalog v1",
  "type": "object",
  "required": [
    "schema_version",
    "topics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "group",
          "core_meaning",
          "when_to_use",
          "how_to_use",
          "epistemic_status",
          "source",
          "source_snapshot",
          "source_lines",
          "path",
          "sha256",
          "flags",
          "keywords",
          "related"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "core_meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "when_to_use": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "how_to_use": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "epistemic_status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "do_not_use_for": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "source_snapshot": {
            "type": "string",
            "minLength": 1,
            "description": "包内相对路径，禁止绝对路径、反斜杠、..、符号链接越界；运行时核对真实路径。"
          },
          "source_markdown": {
            "type": "string",
            "minLength": 1,
            "description": "包内相对路径，禁止绝对路径、反斜杠、..、符号链接越界；运行时核对真实路径。"
          },
          "source_lines": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "path": {
            "type": "string",
            "pattern": "^topics/.+\\.md$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
